{
  "name": "@masax/lex",
  "version": "0.4.0",
  "private": true,
  "description": "LexCom storage engine: .ddm/.fdt schemas, sorted .pnt indexes, variable-length .bin records",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@emdzej/csfs-core": "^0.1.1",
    "@masax/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.1"
  }
}
